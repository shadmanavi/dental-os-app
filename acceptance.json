  "sql": {
    "priorities": "SELECT pl.Priority, d.ItemName, d.ItemOrder, COUNT(*) AS Cnt, SUM(pl.ProcFee) AS Total FROM procedurelog pl LEFT JOIN definition d ON d.DefNum = pl.Priority WHERE pl.ProcStatus = 1 AND pl.ProcDate >= '2026-02-14' AND pl.ProcDate <= '2026-08-14' GROUP BY pl.Priority, d.ItemName, d.ItemOrder ORDER BY Cnt DESC",
    "vocabulary": "SELECT d.DefNum, d.ItemName, d.ItemOrder, d.ItemValue, d.IsHidden FROM definition d WHERE d.Category = ( SELECT Category FROM definition WHERE DefNum = 147 ) ORDER BY d.ItemOrder"
