  "sql": {
    "patient": "SELECT p.PatNum, p.FeeSched, fs.Description AS FeeSchedName, fs.FeeSchedType FROM patient p LEFT JOIN feesched fs ON fs.FeeSchedNum = p.FeeSched WHERE p.PatNum IN (17,21042)",
    "plans": "SELECT pp.PatNum, pp.PatPlanNum, pp.Ordinal, pp.IsPending, pp.InsSubNum, isub.PlanNum, isub.DateEffective, isub.DateTerm, ip.FeeSched, ip.PlanType, ip.CopayFeeSched, ip.IsMedical, fs.Description AS FeeSchedName, fs.FeeSchedType, c.CarrierName FROM patplan pp LEFT JOIN inssub isub ON isub.InsSubNum = pp.InsSubNum LEFT JOIN insplan ip ON ip.PlanNum = isub.PlanNum LEFT JOIN feesched fs ON fs.FeeSchedNum = ip.FeeSched LEFT JOIN carrier c ON c.CarrierNum = ip.CarrierNum WHERE pp.PatNum IN (17,21042) ORDER BY pp.PatNum, pp.Ordinal",
    "fee": "SELECT f.FeeSched AS FeeSchedNum, f.CodeNum, f.Amount, f.ClinicNum, f.ProvNum, pc.ProcCode, pc.Descript, fs.Description AS FeeSchedName FROM fee f INNER JOIN procedurecode pc ON pc.CodeNum = f.CodeNum LEFT JOIN feesched fs ON fs.FeeSchedNum = f.FeeSched WHERE f.FeeSched IN (410,409) AND pc.ProcCode IN ('D2751','D2751d','D2750','D2750d','D2740','D2740d') ORDER BY f.FeeSched, pc.ProcCode"
  },
